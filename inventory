<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Inventory Management System</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#1e3a8a',
                        secondary: '#3b82f6',
                        accent: '#f59e0b',
                        dark: '#0f172a',
                        light: '#f8fafc'
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .nav-active { background-color: #3b82f6; color: white; }
        .nav-item:hover:not(.nav-active) { background-color: #e2e8f0; }
        .toast-enter { transform: translateY(100%); opacity: 0; }
        .toast-enter-active { transform: translateY(0); opacity: 1; transition: all 0.3s ease-out; }
        .toast-exit { transform: translateY(0); opacity: 1; }
        .toast-exit-active { transform: translateY(100%); opacity: 0; transition: all 0.3s ease-in; }
    </style>
</head>
<body class="bg-gray-100 h-screen overflow-hidden text-gray-800">

    <div id="app" class="flex h-full w-full hidden">
        
        <!-- Sidebar Navigation -->
        <aside class="w-64 bg-white border-r border-gray-200 flex flex-col shadow-sm flex-shrink-0 z-10 transition-all duration-300 relative" id="sidebar">
            <div class="h-16 flex items-center justify-between px-6 border-b border-gray-200">
                <div class="flex items-center gap-2 font-bold text-xl text-primary">
                    <i class="fa-solid fa-book-open"></i>
                    <span>BookFlow</span>
                </div>
                <button id="close-sidebar-btn" class="md:hidden text-gray-500 hover:text-gray-700">
                    <i class="fa-solid fa-times"></i>
                </button>
            </div>
            
            <nav class="flex-1 overflow-y-auto py-4 px-3 space-y-1">
                <a href="#" data-target="dashboard" class="nav-link nav-active flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium text-sm transition-colors">
                    <i class="fa-solid fa-chart-pie w-5 text-center"></i> Dashboard
                </a>
                <a href="#" data-target="books" class="nav-link nav-item text-gray-700 flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium text-sm transition-colors">
                    <i class="fa-solid fa-book w-5 text-center"></i> Book Master
                </a>
                <a href="#" data-target="inventory" class="nav-link nav-item text-gray-700 flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium text-sm transition-colors">
                    <i class="fa-solid fa-right-left w-5 text-center"></i> Transactions
                </a>
                <a href="#" data-target="reports" class="nav-link nav-item text-gray-700 flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium text-sm transition-colors">
                    <i class="fa-solid fa-file-invoice w-5 text-center"></i> Reports
                </a>
            </nav>
            
            <div class="p-4 border-t border-gray-200 text-xs text-gray-500">
                <p>Logged in as <span id="user-display" class="font-semibold text-gray-700 truncate block">...</span></p>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="flex-1 flex flex-col h-full overflow-hidden relative">
            <!-- Mobile Header -->
            <header class="md:hidden h-16 bg-white border-b border-gray-200 flex items-center px-4 justify-between flex-shrink-0">
                <div class="flex items-center gap-2 font-bold text-lg text-primary">
                    <i class="fa-solid fa-book-open"></i> BookFlow
                </div>
                <button id="open-sidebar-btn" class="text-gray-600 focus:outline-none p-2">
                    <i class="fa-solid fa-bars text-xl"></i>
                </button>
            </header>

            <!-- Scrollable Content -->
            <div class="flex-1 overflow-y-auto p-4 md:p-8 bg-gray-50 hide-scrollbar relative">
                
                <section id="sec-dashboard" class="content-section block">
                    <div class="flex justify-between items-end mb-6">
                        <div>
                            <h2 class="text-2xl font-bold text-gray-800">Dashboard</h2>
                            <p class="text-sm text-gray-500 mt-1">Overview of your complete inventory</p>
                        </div>
                        <button onclick="refreshData()" class="text-gray-500 hover:text-primary transition-colors text-sm flex items-center gap-2">
                            <i class="fa-solid fa-rotate-right"></i> Refresh
                        </button>
                    </div>

                    <!-- KPI Cards -->
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
                        <div class="bg-white p-5 rounded-xl border border-gray-100 shadow-sm flex flex-col">
                            <div class="flex justify-between items-start">
                                <div>
                                    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Total Books in Stock</p>
                                    <h3 class="text-3xl font-bold text-gray-800 mt-1" id="kpi-total-books">0</h3>
                                </div>
                                <div class="w-10 h-10 rounded-full bg-blue-50 text-blue-500 flex items-center justify-center text-lg">
                                    <i class="fa-solid fa-layer-group"></i>
                                </div>
                            </div>
                        </div>
                        
                        <div class="bg-white p-5 rounded-xl border border-gray-100 shadow-sm flex flex-col">
                            <div class="flex justify-between items-start">
                                <div>
                                    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Unique Titles</p>
                                    <h3 class="text-3xl font-bold text-gray-800 mt-1" id="kpi-total-titles">0</h3>
                                </div>
                                <div class="w-10 h-10 rounded-full bg-purple-50 text-purple-500 flex items-center justify-center text-lg">
                                    <i class="fa-solid fa-tags"></i>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white p-5 rounded-xl border border-gray-100 shadow-sm flex flex-col">
                            <div class="flex justify-between items-start">
                                <div>
                                    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Out of Stock</p>
                                    <h3 class="text-3xl font-bold text-red-600 mt-1" id="kpi-out-of-stock">0</h3>
                                </div>
                                <div class="w-10 h-10 rounded-full bg-red-50 text-red-500 flex items-center justify-center text-lg">
                                    <i class="fa-solid fa-triangle-exclamation"></i>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white p-5 rounded-xl border border-gray-100 shadow-sm flex flex-col">
                            <div class="flex justify-between items-start">
                                <div>
                                    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Inventory Value</p>
                                    <h3 class="text-3xl font-bold text-green-600 mt-1" id="kpi-inventory-value">₹0</h3>
                                </div>
                                <div class="w-10 h-10 rounded-full bg-green-50 text-green-500 flex items-center justify-center text-lg">
                                    <i class="fa-solid fa-indian-rupee-sign"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Charts Row -->
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
                        <div class="bg-white p-5 rounded-xl border border-gray-100 shadow-sm">
                            <h4 class="font-semibold text-gray-700 mb-4 text-sm uppercase tracking-wide">Stock Distribution</h4>
                            <div class="relative h-64 w-full flex items-center justify-center">
                                <canvas id="stockDistributionChart"></canvas>
                            </div>
                        </div>
                        <div class="bg-white p-5 rounded-xl border border-gray-100 shadow-sm">
                            <h4 class="font-semibold text-gray-700 mb-4 text-sm uppercase tracking-wide">Monthly Receipts vs Issues</h4>
                            <div class="relative h-64 w-full">
                                <canvas id="monthlyMovementChart"></canvas>
                            </div>
                        </div>
                    </div>
                </section>

                <section id="sec-books" class="content-section hidden">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end mb-6 gap-4">
                        <div>
                            <h2 class="text-2xl font-bold text-gray-800">Book Master</h2>
                            <p class="text-sm text-gray-500 mt-1">Manage your catalogue of books</p>
                        </div>
                        <button onclick="openModal('add-book-modal')" class="bg-primary hover:bg-blue-800 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors shadow-sm flex items-center gap-2">
                            <i class="fa-solid fa-plus"></i> Add New Book
                        </button>
                    </div>

                    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden flex flex-col">
                        <div class="p-4 border-b border-gray-100 flex gap-4 bg-gray-50">
                            <div class="relative flex-1 max-w-md">
                                <i class="fa-solid fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                                <input type="text" id="book-search" placeholder="Search by title, code, author..." class="w-full pl-10 pr-4 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent">
                            </div>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-sm whitespace-nowrap">
                                <thead class="bg-gray-50 text-gray-600 font-semibold border-b border-gray-200">
                                    <tr>
                                        <th class="px-6 py-3">Book Code</th>
                                        <th class="px-6 py-3">Title & Author</th>
                                        <th class="px-6 py-3">Category</th>
                                        <th class="px-6 py-3 text-right">Price</th>
                                        <th class="px-6 py-3 text-center">Opening</th>
                                        <th class="px-6 py-3 text-center">Current Stock</th>
                                        <th class="px-6 py-3 text-center">Status</th>
                                        <th class="px-6 py-3 text-right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="books-table-body" class="divide-y divide-gray-100">
                                    <!-- Books will be populated here -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <section id="sec-inventory" class="content-section hidden">
                    <div class="mb-6">
                        <h2 class="text-2xl font-bold text-gray-800">Inventory Transactions</h2>
                        <p class="text-sm text-gray-500 mt-1">Record stock movements (Receipts, Issues, Adjustments)</p>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                        <!-- Transaction Form -->
                        <div class="lg:col-span-1 bg-white p-6 rounded-xl border border-gray-100 shadow-sm h-fit">
                            <h3 class="font-bold text-gray-700 border-b pb-3 mb-4 text-sm uppercase">New Entry</h3>
                            <form id="transaction-form" class="space-y-4">
                                <div>
                                    <label class="block text-xs font-semibold text-gray-600 mb-1">Transaction Type <span class="text-red-500">*</span></label>
                                    <select id="tx-type" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent">
                                        <option value="receipt">Book Receipt (+)</option>
                                        <option value="issue">Issue / Sale (-)</option>
                                        <option value="return">Return (+)</option>
                                        <option value="damaged">Damaged / Lost (-)</option>
                                        <option value="adjustment">Stock Adjustment (±)</option>
                                    </select>
                                </div>
                                
                                <div>
                                    <label class="block text-xs font-semibold text-gray-600 mb-1">Select Book <span class="text-red-500">*</span></label>
                                    <select id="tx-book" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent">
                                        <option value="">-- Select a Book --</option>
                                        <!-- Options populated via JS -->
                                    </select>
                                    <p id="tx-current-stock-hint" class="text-xs text-gray-500 mt-1 italic hidden">Current stock: <span id="tx-hint-val" class="font-bold"></span></p>
                                </div>

                                <div>
                                    <label class="block text-xs font-semibold text-gray-600 mb-1">Date <span class="text-red-500">*</span></label>
                                    <input type="date" id="tx-date" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent">
                                </div>

                                <div>
                                    <label class="block text-xs font-semibold text-gray-600 mb-1" id="lbl-qty">Quantity <span class="text-red-500">*</span></label>
                                    <input type="number" id="tx-quantity" min="1" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="e.g. 10">
                                </div>

                                <div>
                                    <label class="block text-xs font-semibold text-gray-600 mb-1">Remarks / Reference</label>
                                    <input type="text" id="tx-remarks" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="Invoice # or Notes">
                                </div>

                                <button type="submit" class="w-full bg-primary hover:bg-blue-800 text-white font-semibold py-2.5 rounded-lg text-sm transition-colors mt-2">
                                    Save Transaction
                                </button>
                            </form>
                        </div>

                        <!-- Recent Transactions -->
                        <div class="lg:col-span-2 bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden flex flex-col">
                            <div class="p-4 border-b border-gray-100 bg-gray-50">
                                <h3 class="font-bold text-gray-700 text-sm uppercase">Recent Transactions</h3>
                            </div>
                            <div class="overflow-x-auto flex-1">
                                <table class="w-full text-left text-sm whitespace-nowrap">
                                    <thead class="bg-gray-50 text-gray-500 font-medium border-b border-gray-200 text-xs">
                                        <tr>
                                            <th class="px-4 py-3">Date</th>
                                            <th class="px-4 py-3">Type</th>
                                            <th class="px-4 py-3">Book</th>
                                            <th class="px-4 py-3 text-right">Qty</th>
                                            <th class="px-4 py-3">Remarks</th>
                                        </tr>
                                    </thead>
                                    <tbody id="recent-tx-body" class="divide-y divide-gray-100">
                                        <!-- Recent TX injected here -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>

                <section id="sec-reports" class="content-section hidden flex-col h-full">
                    <div class="mb-4">
                        <h2 class="text-2xl font-bold text-gray-800">Inventory Reports</h2>
                        <p class="text-sm text-gray-500 mt-1">Detailed view of current stock and alerts</p>
                    </div>

                    <div class="bg-white rounded-xl shadow-sm border border-gray-100 flex flex-col flex-1 min-h-[400px]">
                        <div class="p-4 border-b border-gray-100 bg-gray-50 flex gap-2 overflow-x-auto hide-scrollbar">
                            <button class="report-filter-btn px-4 py-2 text-sm font-medium rounded-lg bg-primary text-white" data-filter="all">Full Inventory</button>
                            <button class="report-filter-btn px-4 py-2 text-sm font-medium rounded-lg bg-white text-gray-600 border border-gray-200 hover:bg-gray-100" data-filter="low">Low Stock Alerts</button>
                            <button class="report-filter-btn px-4 py-2 text-sm font-medium rounded-lg bg-white text-gray-600 border border-gray-200 hover:bg-gray-100" data-filter="out">Out of Stock</button>
                        </div>
                        <div class="overflow-x-auto flex-1">
                            <table class="w-full text-left text-sm whitespace-nowrap">
                                <thead class="bg-gray-50 text-gray-600 font-semibold border-b border-gray-200 sticky top-0 z-10 shadow-sm">
                                    <tr>
                                        <th class="px-6 py-3">Book Details</th>
                                        <th class="px-4 py-3 text-center">Opening</th>
                                        <th class="px-4 py-3 text-center text-green-600">Received</th>
                                        <th class="px-4 py-3 text-center text-red-600">Issued</th>
                                        <th class="px-4 py-3 text-center text-blue-600">Returns</th>
                                        <th class="px-4 py-3 text-center text-orange-500">Damaged</th>
                                        <th class="px-6 py-3 text-center font-bold">Current Balance</th>
                                    </tr>
                                </thead>
                                <tbody id="reports-table-body" class="divide-y divide-gray-100">
                                    <!-- Report Data -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

            </div>
        </main>
    </div>

    
    <!-- Add Book Modal -->
    <div id="add-book-modal" class="fixed inset-0 bg-gray-900 bg-opacity-50 z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-2xl max-h-[90vh] flex flex-col animate-[fadeIn_0.2s_ease-out]">
            <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50 rounded-t-xl">
                <h3 class="font-bold text-lg text-gray-800">Add New Book</h3>
                <button onclick="closeModal('add-book-modal')" class="text-gray-400 hover:text-gray-600 transition-colors">
                    <i class="fa-solid fa-times text-xl"></i>
                </button>
            </div>
            <div class="p-6 overflow-y-auto flex-1 hide-scrollbar">
                <form id="add-book-form" class="space-y-5">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">Book Code (Auto or Custom) <span class="text-red-500">*</span></label>
                            <input type="text" id="bk-code" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary" placeholder="e.g. BK-001">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">Book Name <span class="text-red-500">*</span></label>
                            <input type="text" id="bk-name" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">Author Name <span class="text-red-500">*</span></label>
                            <input type="text" id="bk-author" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">Publisher</label>
                            <input type="text" id="bk-publisher" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">Category</label>
                            <select id="bk-category" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary">
                                <option value="Fiction">Fiction</option>
                                <option value="Non-Fiction">Non-Fiction</option>
                                <option value="Academic">Academic</option>
                                <option value="Science">Science</option>
                                <option value="History">History</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">Price (₹) <span class="text-red-500">*</span></label>
                            <input type="number" id="bk-price" min="0" step="0.01" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary" placeholder="0.00">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">Opening Stock <span class="text-red-500">*</span></label>
                            <input type="number" id="bk-opening" min="0" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary" value="0">
                            <p class="text-[10px] text-gray-500 mt-1 leading-tight">Initial stock level. Subsequent changes must be done via Transactions.</p>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">Min. Stock Level <span class="text-red-500">*</span></label>
                            <input type="number" id="bk-minstock" min="0" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary" value="5">
                        </div>
                    </div>
                </form>
            </div>
            <div class="px-6 py-4 border-t border-gray-100 flex justify-end gap-3 bg-gray-50 rounded-b-xl">
                <button onclick="closeModal('add-book-modal')" class="px-4 py-2 text-sm font-medium text-gray-600 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">Cancel</button>
                <button onclick="submitBookForm()" class="px-4 py-2 text-sm font-medium text-white bg-primary rounded-lg hover:bg-blue-800 transition-colors">Save Book Master</button>
            </div>
        </div>
    </div>

    <!-- History Modal -->
    <div id="history-modal" class="fixed inset-0 bg-gray-900 bg-opacity-50 z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-3xl max-h-[90vh] flex flex-col animate-[fadeIn_0.2s_ease-out]">
            <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50 rounded-t-xl">
                <h3 class="font-bold text-lg text-gray-800" id="hist-title">Book History</h3>
                <button onclick="closeModal('history-modal')" class="text-gray-400 hover:text-gray-600 transition-colors">
                    <i class="fa-solid fa-times text-xl"></i>
                </button>
            </div>
            <div class="p-6 overflow-y-auto flex-1 hide-scrollbar">
                <div class="flex justify-between items-center mb-4 p-4 bg-blue-50 rounded-lg border border-blue-100">
                    <div>
                        <p class="text-xs text-blue-600 font-semibold uppercase">Current Stock Calculation</p>
                        <p class="text-sm font-medium mt-1 text-gray-700" id="hist-formula">Opening: 0 + ... = 0</p>
                    </div>
                    <div class="text-right">
                        <p class="text-xs text-blue-600 font-semibold uppercase">Current Balance</p>
                        <p class="text-2xl font-bold text-blue-800" id="hist-balance">0</p>
                    </div>
                </div>
                
                <table class="w-full text-left text-sm">
                    <thead class="bg-gray-100 text-gray-600 font-medium border-b border-gray-200">
                        <tr>
                            <th class="px-4 py-2">Date</th>
                            <th class="px-4 py-2">Transaction Type</th>
                            <th class="px-4 py-2 text-right">Qty Impact</th>
                            <th class="px-4 py-2 text-right">Running Bal.</th>
                            <th class="px-4 py-2">Remarks</th>
                        </tr>
                    </thead>
                    <tbody id="hist-table-body" class="divide-y divide-gray-100">
                        <!-- History injected here -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Loading Overlay -->
    <div id="loading-overlay" class="fixed inset-0 bg-white z-[100] flex flex-col items-center justify-center">
        <i class="fa-solid fa-circle-notch fa-spin text-4xl text-primary mb-4"></i>
        <p class="text-gray-600 font-medium">Loading BookFlow System...</p>
    </div>

    <!-- Toast Container -->
    <div id="toast-container" class="fixed bottom-4 right-4 z-[9999] flex flex-col gap-2 pointer-events-none"></div>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, collection, onSnapshot, addDoc, serverTimestamp, getDocs } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Environment variables
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'book-inventory-app';
        let firebaseConfig = null;
        if (typeof __firebase_config !== 'undefined') {
            try { firebaseConfig = JSON.parse(__firebase_config); } catch (e) { console.error("Invalid firebase config"); }
        }

        // State variables
        let app, auth, db;
        let currentUser = null;
        let booksData = [];
        let transactionsData = [];
        let computedInventory = [];
        
        // Chart instances
        let stockDistChart = null;
        let monthlyChart = null;

        // Initialize Firebase
        if (firebaseConfig) {
            app = initializeApp(firebaseConfig);
            auth = getAuth(app);
            db = getFirestore(app);
            
            const initialToken = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;
            if (initialToken) {
                signInWithCustomToken(auth, initialToken).catch(err => {
                    console.error("Custom token failed, falling back to anonymous", err);
                    signInAnonymously(auth);
                });
            } else {
                signInAnonymously(auth);
            }

            onAuthStateChanged(auth, (user) => {
                if (user) {
                    currentUser = user;
                    document.getElementById('user-display').textContent = user.uid;
                    document.getElementById('loading-overlay').classList.add('hidden');
                    document.getElementById('app').classList.remove('hidden');
                    
                    // Generate dummy data if requested in future, for now setup listeners
                    setupListeners();
                }
            });
        } else {
            document.getElementById('loading-overlay').innerHTML = "<p class='text-red-500'>Firebase config missing. Running in UI only mode.</p>";
            document.getElementById('app').classList.remove('hidden');
        }

        function getCollectionPath(colName) {
            return collection(db, 'artifacts', appId, 'users', currentUser.uid, colName);
        }

        function setupListeners() {
            // Listen to Books
            onSnapshot(getCollectionPath('books'), (snapshot) => {
                booksData = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
                computeInventory();
            }, (error) => showToast("Error loading books: " + error.message, "error"));

            // Listen to Transactions
            onSnapshot(getCollectionPath('transactions'), (snapshot) => {
                transactionsData = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
                // Sort transactions by date asc, then createdAt asc
                transactionsData.sort((a, b) => {
                    const dateA = new Date(a.date).getTime();
                    const dateB = new Date(b.date).getTime();
                    if(dateA === dateB) {
                        return (a.createdAt?.toMillis() || 0) - (b.createdAt?.toMillis() || 0);
                    }
                    return dateA - dateB;
                });
                computeInventory();
            }, (error) => showToast("Error loading transactions: " + error.message, "error"));
        }

        function computeInventory() {
            computedInventory = booksData.map(book => {
                const bookTxs = transactionsData.filter(t => t.bookId === book.id);
                
                let currentStock = Number(book.openingStock) || 0;
                let totalReceived = 0, totalIssued = 0, totalReturned = 0, totalDamaged = 0, totalAdjustments = 0;
                
                bookTxs.forEach(tx => {
                    const qty = Number(tx.quantity);
                    switch(tx.type) {
                        case 'receipt': currentStock += qty; totalReceived += qty; break;
                        case 'issue': currentStock -= qty; totalIssued += qty; break;
                        case 'return': currentStock += qty; totalReturned += qty; break;
                        case 'damaged': currentStock -= qty; totalDamaged += qty; break;
                        case 'adjustment': currentStock += qty; totalAdjustments += qty; break; // assume adjustment can be +/- entered as qty
                    }
                });

                let status = 'In Stock';
                if (currentStock <= 0) status = 'Out of Stock';
                else if (currentStock <= Number(book.minStock)) status = 'Low Stock';

                return { 
                    ...book, 
                    currentStock, 
                    totalReceived, 
                    totalIssued, 
                    totalReturned, 
                    totalDamaged,
                    totalAdjustments,
                    status,
                    bookTxs
                };
            });

            updateUI();
        }

        window.refreshData = function() {
            showToast("Data refreshed.", "success");
            computeInventory();
        }

        function updateUI() {
            renderDashboard();
            renderBooksTable();
            renderTransactionFormDropdown();
            renderRecentTransactions();
            renderReportsTable(document.querySelector('.report-filter-btn.bg-primary').dataset.filter);
        }

        function renderDashboard() {
            let totalBooks = 0;
            let totalValue = 0;
            let outOfStockCount = 0;
            
            let stockCats = { inStock: 0, lowStock: 0, outOfStock: 0 };
            
            // For Monthly Movement chart
            let monthlyData = {}; // Format: { "YYYY-MM": { rec: 0, iss: 0 } }
            
            computedInventory.forEach(book => {
                totalBooks += book.currentStock;
                totalValue += (book.currentStock * Number(book.price || 0));
                
                if(book.status === 'Out of Stock') { outOfStockCount++; stockCats.outOfStock++; }
                else if(book.status === 'Low Stock') { stockCats.lowStock++; }
                else { stockCats.inStock++; }
            });

            transactionsData.forEach(tx => {
                if(tx.date) {
                    const monthKey = tx.date.substring(0, 7); // YYYY-MM
                    if(!monthlyData[monthKey]) monthlyData[monthKey] = { rec: 0, iss: 0 };
                    if(tx.type === 'receipt') monthlyData[monthKey].rec += Number(tx.quantity);
                    if(tx.type === 'issue') monthlyData[monthKey].iss += Number(tx.quantity);
                }
            });

            document.getElementById('kpi-total-books').textContent = totalBooks;
            document.getElementById('kpi-total-titles').textContent = computedInventory.length;
            document.getElementById('kpi-out-of-stock').textContent = outOfStockCount;
            document.getElementById('kpi-inventory-value').textContent = "₹" + totalValue.toLocaleString('en-IN', { maximumFractionDigits: 2 });

            renderCharts(stockCats, monthlyData);
        }

        function renderCharts(stockCats, monthlyData) {
            // Stock Distribution Chart
            const ctxDist = document.getElementById('stockDistributionChart').getContext('2d');
            if (stockDistChart) stockDistChart.destroy();
            
            stockDistChart = new Chart(ctxDist, {
                type: 'doughnut',
                data: {
                    labels: ['In Stock', 'Low Stock', 'Out of Stock'],
                    datasets: [{
                        data: [stockCats.inStock, stockCats.lowStock, stockCats.outOfStock],
                        backgroundColor: ['#10b981', '#f59e0b', '#ef4444'],
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, font: {family: "'Inter', sans-serif"} } } },
                    cutout: '70%'
                }
            });

            // Monthly Movement Chart
            const ctxMove = document.getElementById('monthlyMovementChart').getContext('2d');
            if (monthlyChart) monthlyChart.destroy();

            // Sort months
            const sortedMonths = Object.keys(monthlyData).sort().slice(-6); // Last 6 months
            const labels = sortedMonths.map(m => {
                const d = new Date(m + "-01");
                return d.toLocaleDateString('default', { month: 'short', year: '2-digit' });
            });
            const recData = sortedMonths.map(m => monthlyData[m].rec);
            const issData = sortedMonths.map(m => monthlyData[m].iss);

            monthlyChart = new Chart(ctxMove, {
                type: 'bar',
                data: {
                    labels: labels.length ? labels : ['No Data'],
                    datasets: [
                        { label: 'Received', data: labels.length ? recData : [0], backgroundColor: '#3b82f6', borderRadius: 4 },
                        { label: 'Issued', data: labels.length ? issData : [0], backgroundColor: '#ef4444', borderRadius: 4 }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'top', labels: { usePointStyle: true, boxWidth: 8, font: {family: "'Inter', sans-serif"} } } },
                    scales: {
                        y: { beginAtZero: true, grid: { borderDash: [2, 4], color: '#f1f5f9' } },
                        x: { grid: { display: false } }
                    }
                }
            });
        }

        function renderBooksTable() {
            const tbody = document.getElementById('books-table-body');
            const searchQ = document.getElementById('book-search').value.toLowerCase();
            
            tbody.innerHTML = '';
            
            computedInventory
                .filter(b => b.name.toLowerCase().includes(searchQ) || b.code.toLowerCase().includes(searchQ) || b.author.toLowerCase().includes(searchQ))
                .forEach(book => {
                    let statusBadge = '';
                    if (book.status === 'In Stock') statusBadge = '<span class="px-2.5 py-1 bg-green-100 text-green-700 rounded-full text-xs font-semibold">In Stock</span>';
                    else if (book.status === 'Low Stock') statusBadge = '<span class="px-2.5 py-1 bg-yellow-100 text-yellow-700 rounded-full text-xs font-semibold">Low Stock</span>';
                    else statusBadge = '<span class="px-2.5 py-1 bg-red-100 text-red-700 rounded-full text-xs font-semibold">Out of Stock</span>';

                    const tr = document.createElement('tr');
                    tr.className = 'hover:bg-gray-50 transition-colors';
                    tr.innerHTML = `
                        <td class="px-6 py-4 font-mono text-xs text-gray-500">${book.code}</td>
                        <td class="px-6 py-4">
                            <p class="font-semibold text-gray-800">${book.name}</p>
                            <p class="text-xs text-gray-500">${book.author}</p>
                        </td>
                        <td class="px-6 py-4 text-gray-600">${book.category || '-'}</td>
                        <td class="px-6 py-4 text-right">₹${Number(book.price).toFixed(2)}</td>
                        <td class="px-6 py-4 text-center text-gray-500">${book.openingStock}</td>
                        <td class="px-6 py-4 text-center font-bold text-gray-800">${book.currentStock}</td>
                        <td class="px-6 py-4 text-center">${statusBadge}</td>
                        <td class="px-6 py-4 text-right">
                            <button onclick="viewHistory('${book.id}')" class="text-blue-500 hover:text-blue-700 text-sm font-medium"><i class="fa-solid fa-clock-rotate-left mr-1"></i> History</button>
                        </td>
                    `;
                    tbody.appendChild(tr);
            });
            if(tbody.innerHTML === '') {
                tbody.innerHTML = `<tr><td colspan="8" class="text-center py-8 text-gray-500">No books found matching search criteria.</td></tr>`;
            }
        }
        
        document.getElementById('book-search').addEventListener('input', renderBooksTable);

        window.submitBookForm = async function() {
            if (!currentUser) return;
            
            const code = document.getElementById('bk-code').value.trim();
            const name = document.getElementById('bk-name').value.trim();
            const author = document.getElementById('bk-author').value.trim();
            const pub = document.getElementById('bk-publisher').value.trim();
            const cat = document.getElementById('bk-category').value;
            const price = document.getElementById('bk-price').value;
            const opening = document.getElementById('bk-opening').value;
            const minstock = document.getElementById('bk-minstock').value;

            if(!code || !name || !author || !price || !opening || !minstock) {
                showToast("Please fill all required fields.", "error");
                return;
            }

            // check duplicate code
            if (booksData.some(b => b.code.toLowerCase() === code.toLowerCase())) {
                showToast("Book code already exists. Use a unique code.", "error");
                return;
            }

            const bookData = {
                code, name, author, publisher: pub, category: cat,
                price: Number(price), openingStock: Number(opening), minStock: Number(minstock),
                createdAt: serverTimestamp()
            };

            try {
                await addDoc(getCollectionPath('books'), bookData);
                showToast("Book added successfully!", "success");
                closeModal('add-book-modal');
                document.getElementById('add-book-form').reset();
            } catch(e) {
                showToast("Failed to add book: " + e.message, "error");
            }
        }

        function renderTransactionFormDropdown() {
            const select = document.getElementById('tx-book');
            const currentVal = select.value;
            select.innerHTML = '<option value="">-- Select a Book --</option>';
            
            // Sort books alphabetically by name
            const sorted = [...computedInventory].sort((a,b) => a.name.localeCompare(b.name));
            
            sorted.forEach(b => {
                const opt = document.createElement('option');
                opt.value = b.id;
                opt.textContent = `${b.code} - ${b.name} (Stock: ${b.currentStock})`;
                select.appendChild(opt);
            });
            
            if(currentVal && sorted.find(b=>b.id === currentVal)) {
                select.value = currentVal;
            }
        }

        document.getElementById('tx-book').addEventListener('change', function(e) {
            const hint = document.getElementById('tx-current-stock-hint');
            if(!this.value) { hint.classList.add('hidden'); return; }
            const book = computedInventory.find(b => b.id === this.value);
            if(book) {
                document.getElementById('tx-hint-val').textContent = book.currentStock;
                document.getElementById('tx-hint-val').className = book.currentStock > 0 ? "font-bold text-green-600" : "font-bold text-red-600";
                hint.classList.remove('hidden');
            }
        });
        
        // Auto-set today's date
        document.getElementById('tx-date').valueAsDate = new Date();

        document.getElementById('transaction-form').addEventListener('submit', async function(e) {
            e.preventDefault();
            if (!currentUser) return;

            const type = document.getElementById('tx-type').value;
            const bookId = document.getElementById('tx-book').value;
            const date = document.getElementById('tx-date').value;
            let qty = Number(document.getElementById('tx-quantity').value);
            const remarks = document.getElementById('tx-remarks').value;

            if(!bookId || !date || !qty) {
                showToast("Please fill all required fields.", "error");
                return;
            }

            const book = computedInventory.find(b => b.id === bookId);
            if(!book) return;

            // Validation: Prevent negative stock on issues/damaged
            if (type === 'issue' || type === 'damaged') {
                if (qty > book.currentStock) {
                    showToast(`Insufficient Stock! Only ${book.currentStock} copies available.`, "error");
                    return;
                }
            }

            const txData = {
                bookId,
                bookCode: book.code,
                bookName: book.name,
                type,
                date,
                quantity: qty,
                remarks,
                createdAt: serverTimestamp()
            };

            const btn = this.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';

            try {
                await addDoc(getCollectionPath('transactions'), txData);
                showToast("Transaction saved successfully!", "success");
                this.reset();
                document.getElementById('tx-date').valueAsDate = new Date();
                document.getElementById('tx-current-stock-hint').classList.add('hidden');
            } catch(error) {
                showToast("Transaction failed: " + error.message, "error");
            } finally {
                btn.disabled = false;
                btn.textContent = 'Save Transaction';
            }
        });

        function renderRecentTransactions() {
            const tbody = document.getElementById('recent-tx-body');
            tbody.innerHTML = '';
            
            // Get last 15 txs
            const recent = [...transactionsData].reverse().slice(0, 15);
            
            recent.forEach(tx => {
                let icon = '';
                let color = '';
                let sign = '';
                switch(tx.type) {
                    case 'receipt': icon = 'fa-arrow-down'; color = 'text-green-600 bg-green-50'; sign = '+'; break;
                    case 'issue': icon = 'fa-arrow-up'; color = 'text-red-600 bg-red-50'; sign = '-'; break;
                    case 'return': icon = 'fa-arrow-rotate-left'; color = 'text-blue-600 bg-blue-50'; sign = '+'; break;
                    case 'damaged': icon = 'fa-ban'; color = 'text-orange-600 bg-orange-50'; sign = '-'; break;
                    case 'adjustment': icon = 'fa-sliders'; color = 'text-gray-600 bg-gray-100'; sign = '±'; break;
                }

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="px-4 py-3 text-gray-500 text-xs">${new Date(tx.date).toLocaleDateString('en-GB')}</td>
                    <td class="px-4 py-3">
                        <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-md text-xs font-medium ${color}">
                            <i class="fa-solid ${icon}"></i> ${tx.type.charAt(0).toUpperCase() + tx.type.slice(1)}
                        </span>
                    </td>
                    <td class="px-4 py-3">
                        <p class="font-medium text-gray-800 text-xs truncate max-w-[150px]">${tx.bookName}</p>
                        <p class="text-[10px] text-gray-500">${tx.bookCode}</p>
                    </td>
                    <td class="px-4 py-3 text-right font-bold text-gray-700">${sign}${tx.quantity}</td>
                    <td class="px-4 py-3 text-xs text-gray-500 truncate max-w-[150px]">${tx.remarks || '-'}</td>
                `;
                tbody.appendChild(tr);
            });
            if(recent.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="text-center py-6 text-gray-500 text-sm">No recent transactions found.</td></tr>';
            }
        }

        // Reports View filtering logic
        document.querySelectorAll('.report-filter-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.report-filter-btn').forEach(b => {
                    b.classList.remove('bg-primary', 'text-white');
                    b.classList.add('bg-white', 'text-gray-600');
                });
                this.classList.remove('bg-white', 'text-gray-600');
                this.classList.add('bg-primary', 'text-white');
                renderReportsTable(this.dataset.filter);
            });
        });

        function renderReportsTable(filterType = 'all') {
            const tbody = document.getElementById('reports-table-body');
            tbody.innerHTML = '';
            
            let filtered = computedInventory;
            if(filterType === 'low') filtered = computedInventory.filter(b => b.status === 'Low Stock');
            if(filterType === 'out') filtered = computedInventory.filter(b => b.status === 'Out of Stock');

            filtered.forEach(book => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-gray-50';
                tr.innerHTML = `
                    <td class="px-6 py-4">
                        <p class="font-semibold text-gray-800">${book.code}</p>
                        <p class="text-xs text-gray-500 truncate max-w-[200px]">${book.name}</p>
                    </td>
                    <td class="px-4 py-3 text-center text-gray-600 font-medium">${book.openingStock}</td>
                    <td class="px-4 py-3 text-center text-green-600 font-medium">${book.totalReceived}</td>
                    <td class="px-4 py-3 text-center text-red-600 font-medium">${book.totalIssued}</td>
                    <td class="px-4 py-3 text-center text-blue-600 font-medium">${book.totalReturned}</td>
                    <td class="px-4 py-3 text-center text-orange-500 font-medium">${book.totalDamaged}</td>
                    <td class="px-6 py-3 text-center text-lg font-bold text-gray-800 bg-gray-50 border-l border-gray-100">${book.currentStock}</td>
                `;
                tbody.appendChild(tr);
            });

            if(filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="text-center py-10 text-gray-500">No data available for the selected filter.</td></tr>`;
            }
        }

        window.viewHistory = function(bookId) {
            const book = computedInventory.find(b => b.id === bookId);
            if(!book) return;

            document.getElementById('hist-title').textContent = `${book.code} - ${book.name}`;
            
            // Formula representation
            let formulaStr = `Opening: ${book.openingStock}`;
            if(book.totalReceived > 0) formulaStr += ` + Rec: ${book.totalReceived}`;
            if(book.totalIssued > 0) formulaStr += ` - Iss: ${book.totalIssued}`;
            if(book.totalReturned > 0) formulaStr += ` + Ret: ${book.totalReturned}`;
            if(book.totalDamaged > 0) formulaStr += ` - Dmg: ${book.totalDamaged}`;
            if(book.totalAdjustments > 0) formulaStr += ` ± Adj: ${book.totalAdjustments}`;
            
            document.getElementById('hist-formula').textContent = formulaStr;
            document.getElementById('hist-balance').textContent = book.currentStock;
            document.getElementById('hist-balance').className = book.currentStock > 0 ? "text-2xl font-bold text-blue-800" : "text-2xl font-bold text-red-600";

            const tbody = document.getElementById('hist-table-body');
            tbody.innerHTML = '';
            
            // Render Opening Stock row
            let runningBalance = Number(book.openingStock);
            
            tbody.innerHTML += `
                <tr class="bg-gray-50">
                    <td class="px-4 py-3 text-xs text-gray-500">-</td>
                    <td class="px-4 py-3 font-medium text-gray-700">Opening Stock</td>
                    <td class="px-4 py-3 text-right text-gray-500">${book.openingStock}</td>
                    <td class="px-4 py-3 text-right font-bold text-gray-800">${runningBalance}</td>
                    <td class="px-4 py-3 text-xs text-gray-500">Initial Setup</td>
                </tr>
            `;

            // Sort txs to ensure correct running balance chronological calculation
            const sortedTxs = [...book.bookTxs].sort((a,b) => {
                const dA = new Date(a.date).getTime();
                const dB = new Date(b.date).getTime();
                if(dA === dB) return (a.createdAt?.toMillis() || 0) - (b.createdAt?.toMillis() || 0);
                return dA - dB;
            });

            sortedTxs.forEach(tx => {
                let qty = Number(tx.quantity);
                let displayQty = '';
                let colorClass = '';
                
                if (['receipt', 'return'].includes(tx.type)) {
                    runningBalance += qty;
                    displayQty = `+${qty}`;
                    colorClass = 'text-green-600';
                } else if (['issue', 'damaged'].includes(tx.type)) {
                    runningBalance -= qty;
                    displayQty = `-${qty}`;
                    colorClass = 'text-red-600';
                } else if (tx.type === 'adjustment') {
                    runningBalance += qty; // assuming entered with sign if needed, or just standard positive
                    displayQty = `±${qty}`;
                    colorClass = 'text-gray-600';
                }

                tbody.innerHTML += `
                    <tr>
                        <td class="px-4 py-3 text-xs text-gray-600 whitespace-nowrap">${new Date(tx.date).toLocaleDateString('en-GB')}</td>
                        <td class="px-4 py-3 text-sm capitalize text-gray-800">${tx.type}</td>
                        <td class="px-4 py-3 text-right font-medium ${colorClass}">${displayQty}</td>
                        <td class="px-4 py-3 text-right font-bold text-gray-800">${runningBalance}</td>
                        <td class="px-4 py-3 text-xs text-gray-500">${tx.remarks || '-'}</td>
                    </tr>
                `;
            });

            openModal('history-modal');
        }

        
        // Navigation Logic
        const navLinks = document.querySelectorAll('.nav-link');
        const sections = document.querySelectorAll('.content-section');
        const sidebar = document.getElementById('sidebar');

        navLinks.forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                const target = link.dataset.target;
                
                // Update UI active states
                navLinks.forEach(l => {
                    l.classList.remove('nav-active');
                    l.classList.add('nav-item', 'text-gray-700');
                });
                link.classList.remove('nav-item', 'text-gray-700');
                link.classList.add('nav-active');

                // Toggle sections
                sections.forEach(sec => sec.classList.add('hidden'));
                document.getElementById(`sec-${target}`).classList.remove('hidden');

                // On mobile, close sidebar on nav click
                if(window.innerWidth < 768) {
                    sidebar.classList.add('-translate-x-full');
                    sidebar.classList.add('absolute');
                }
            });
        });

        // Mobile Sidebar Toggles
        document.getElementById('open-sidebar-btn').addEventListener('click', () => {
            sidebar.classList.remove('-translate-x-full');
            sidebar.classList.add('absolute', 'h-full', 'z-50');
        });
        document.getElementById('close-sidebar-btn').addEventListener('click', () => {
            sidebar.classList.add('-translate-x-full');
        });
        // Initial setup for mobile sidebar
        if(window.innerWidth < 768) {
            sidebar.classList.add('-translate-x-full', 'absolute');
        }

        window.addEventListener('resize', () => {
            if(window.innerWidth >= 768) {
                sidebar.classList.remove('-translate-x-full', 'absolute', 'h-full', 'z-50');
            } else {
                sidebar.classList.add('-translate-x-full', 'absolute');
            }
        });

        // Modal Controls
        window.openModal = function(id) {
            const modal = document.getElementById(id);
            modal.classList.remove('hidden');
            // small trick to force animation
            modal.children[0].style.animation = 'none';
            modal.children[0].offsetHeight; 
            modal.children[0].style.animation = null;
        }
        window.closeModal = function(id) {
            document.getElementById(id).classList.add('hidden');
        }

        // Toast Notification System
        window.showToast = function(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            
            let color = 'bg-gray-800';
            let icon = 'fa-info-circle';
            if (type === 'success') { color = 'bg-green-600'; icon = 'fa-check-circle'; }
            if (type === 'error') { color = 'bg-red-600'; icon = 'fa-exclamation-circle'; }

            toast.className = `flex items-center gap-3 px-4 py-3 rounded-lg shadow-lg text-white text-sm font-medium ${color} toast-enter-active`;
            toast.innerHTML = `<i class="fa-solid ${icon}"></i> <span>${message}</span>`;
            
            container.appendChild(toast);
            
            setTimeout(() => {
                toast.classList.remove('toast-enter-active');
                toast.classList.add('toast-exit-active');
                setTimeout(() => toast.remove(), 300);
            }, 4000);
        }

    </script>
</body>
</html>
